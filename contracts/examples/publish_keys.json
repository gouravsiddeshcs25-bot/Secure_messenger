{
  "request": {
    "method": "POST",
    "path": "/api/keys",
    "body": {
      "username": "alice",
      "identity_pubkey": "<base64 Ed25519 public key>",
      "exchange_pubkey": "<base64 X25519 public key>",
      "key_signature": "<base64 Ed25519 signature over exchange_pubkey>"
    }
  },
  "response": { "status": 200, "body": { "status": "ok", "message": "Keys registered successfully" } }
}
